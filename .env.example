# Fivetran
FIVETRAN_API_KEY=your_key_here
FIVETRAN_API_SECRET=your_secret_here
FIVETRAN_ALLOW_WRITES=true

# Local data layer (DuckDB stands in for BigQuery)
DUCKDB_PATH=./data/supply_chain.duckdb

# Gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# External APIs (optional — falls back to fixture context if unset)
OPENWEATHER_API_KEY=
NEWS_API_KEY=

# App
WEBHOOK_SECRET=replace_with_random_32_chars
USE_MOCK_MCP=true
